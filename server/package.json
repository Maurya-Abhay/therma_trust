{
  "name": "thermatrust-server",
  "version": "1.0.0",
  "private": true,
  "description": "ThermaTrust API: Node.js + Express + MongoDB",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "seed": "node src/scripts/seed.js",
    "alerts:digest": "node src/scripts/send-alert-digest.js",
    "user": "node src/scripts/user-tool.js",
    "import:postgres": "node src/scripts/import-from-postgres.js",
    "vapid": "node src/scripts/generate-vapid-keys.js",
    "test": "node --test --test-concurrency=1 \"test/*.test.js\""
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^7.5.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "libphonenumber-js": "^1.13.15",
    "mongoose": "^8.24.5",
    "multer": "^2.4.0",
    "nodemailer": "^10.1.1",
    "pdfkit": "^0.15.2",
    "qrcode": "^1.5.4",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "pg": "^8.23.1",
    "supertest": "^7.3.1"
  }
}
