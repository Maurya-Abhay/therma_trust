# --- core ---
PORT=8000
NODE_ENV=development
# Node backend requires MongoDB (Atlas: mongodb+srv://user:pass@cluster/dbname).
# Supabase PostgreSQL is NOT a MongoDB replacement.
MONGODB_URI=mongodb://127.0.0.1:27017/thermatrust
# Generate a unique random value (at least 50 characters) for every deployed environment.
JWT_SECRET=change-me-use-a-unique-random-value-of-at-least-50-characters
# Comma-separated origins allowed to call the API from a browser
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Public URL of the web app (used in emailed links, QR codes and labels)
FRONTEND_URL=https://therma-trust-amber.vercel.app
# Public URL of this API (used to build absolute links to uploaded files)
PUBLIC_API_URL=http://localhost:8000
# Local-only upload directory. Use a persistent private volume or private object storage in production.
UPLOAD_DIR=uploads
# Optional ImageKit storage. When both are set, evidence is uploaded to ImageKit.
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=
# Enable only when the reverse proxy correctly sets X-Forwarded-Proto.
TRUST_PROXY=false

# --- email (password reset, alert digest). Without SMTP_HOST, messages are printed to the console ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
DEFAULT_FROM_EMAIL=ThermaTrust <noreply@thermatrust.local>

# --- optional features ---
# Shared secret letting an external scheduler trigger the daily alert digest
ALERTS_CRON_TOKEN=
# AI reading of credential documents
ANTHROPIC_API_KEY=
CREDENTIAL_OCR_MODEL=claude-opus-5-5
# Browser push alerts (generate with: npm run vapid)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTACT=mailto:admin@thermatrust.local
