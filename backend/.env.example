# Local development defaults. Replace every secret/host value for deployment.
SECRET_KEY=change-me-use-a-unique-random-value-of-at-least-50-characters
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

DB_NAME=hvacr
DB_USER=hvacr
DB_PASSWORD=hvacr
DB_HOST=localhost
DB_PORT=5432
# Supabase (or another hosted PostgreSQL) connection URL overrides DB_* when set.
# Copy the PostgreSQL URI from Supabase Project -> Connect. Keep SSL required.
# DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres
DB_SSLMODE=require

CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=
FRONTEND_URL=http://localhost:5173

# Local upload directory only. Production needs durable private storage.
MEDIA_ROOT=./media

EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=ThermaTrust <noreply@thermatrust.local>

# Optional features; leave blank to disable.
ALERTS_CRON_TOKEN=
ANTHROPIC_API_KEY=
CREDENTIAL_OCR_MODEL=claude-opus-5-5
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTACT=mailto:admin@example.com
PUSH_SEND_ASYNC=True
